{
  "name": "myopiaguard",
  "version": "1.0.0",
  "private": true,
  "description": "MyopiaGuard \u2014 classroom eye-health platform that manages screen-break routines across school computers, with teacher dashboards and privacy-preserving school analytics.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "seed": "npm run seed --workspace server --",
    "seed:demo": "npm run seed --workspace server -- --demo",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "serve": "npm run build && npm run start",
    "test:contrast": "node scripts/check-contrast.mjs",
    "fonts": "node scripts/fetch-fonts.mjs"
  }
}
